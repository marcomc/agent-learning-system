# Copy to ~/.config/agent-learning-system/config.env or run ./install.sh.
AGENT_LEARNING_REPO="/path/to/agent-learning-system"
AGENT_LEARNING_VAULT="~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Vault"
AGENT_LEARNING_DIR="AI Agent Learnings"
AGENT_LEARNING_OBSIDIAN_PROVIDER="direct"
AGENT_LEARNING_EMAIL="user@example.com"
AGENT_LEARNING_EMAIL_PROVIDER="gmail"
AGENT_LEARNING_SKILL_MODE="symlink"
